---
const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/blog', label: 'Blog' },
  { href: '/career', label: 'Career' },
  { href: '/education', label: 'Education' },
  { href: '/skills', label: 'Skills' },
  { href: '/awards', label: 'Awards' },
];

const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (href: string) =>
  href === '/' ? pathname === '/' : pathname === href || pathname.startsWith(`${href}/`);
---
<header class="rail">
  <div class="bar">
    <div class="identity">
      <button type="button" class="zoom" aria-haspopup="dialog" aria-controls="portrait-zoom">
        <span class="sr-only">Enlarge photo</span>
        <img src="/assets/img/portrait.jpg" alt="" width="53" height="40" class="portrait" />
      </button>
      <a href="/" class="names">
        <span class="name">Phillip Bruno</span>
        <span class="role field">Lead Data Engineer</span>
      </a>
    </div>

    <div class="controls">
      <button type="button" class="theme" aria-label="Switch colour theme">
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
          <circle cx="8" cy="8" r="6.25" fill="none" stroke="currentColor" stroke-width="1.5" />
          <path d="M8 1.75a6.25 6.25 0 0 1 0 12.5z" fill="currentColor" />
        </svg>
      </button>
      <button type="button" class="toggle" aria-expanded="false" aria-controls="rail-nav">
        <span class="sr-only">Menu</span>
        <span class="bars" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <nav id="rail-nav" class="nav" aria-label="Main">
    <ul>
      {navLinks.map(link => (
        <li>
          <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
            {link.label}
          </a>
        </li>
      ))}
    </ul>
    <p class="locality field">Toronto, ON</p>
  </nav>
</header>

<dialog id="portrait-zoom" class="lightbox" aria-label="Photo">
  <img src="/assets/img/portrait-large.jpg" alt="Still in the snow at the Sendai Miyagikyo Distillery." width="1600" height="1212" loading="lazy" />
  <form method="dialog">
    <button class="close" aria-label="Close">&times;</button>
  </form>
</dialog>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.toggle');
  const nav = document.getElementById('rail-nav');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    nav?.classList.toggle('open', !open);
  });

  const root = document.documentElement;
  const theme = document.querySelector<HTMLButtonElement>('.theme');
  const prefersDark = window.matchMedia('(prefers-color-scheme: dark)');
  const currentTheme = () => root.dataset.theme ?? (prefersDark.matches ? 'dark' : 'light');
  const labelTheme = () => {
    const next = currentTheme() === 'dark' ? 'light' : 'dark';
    theme?.setAttribute('aria-label', `Switch to ${next} theme`);
  };
  labelTheme();
  prefersDark.addEventListener('change', labelTheme);
  theme?.addEventListener('click', () => {
    const next = currentTheme() === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch {}
    labelTheme();
  });

  const zoom = document.querySelector<HTMLButtonElement>('.zoom');
  const lightbox = document.getElementById('portrait-zoom') as HTMLDialogElement | null;
  zoom?.addEventListener('click', () => lightbox?.showModal());
  // Clicking the backdrop (outside the image) closes it.
  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) lightbox.close();
  });
</script>

<style>
  .rail {
    padding: 1.25rem 0 0;
    border-bottom: 1px solid var(--rule);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1.25rem;
  }

  .identity {
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }
  .zoom {
    display: block;
    flex-shrink: 0;
    padding: 0;
    border: none;
    background: none;
    border-radius: 6px;
    cursor: zoom-in;
  }
  .zoom:focus-visible { outline: 2px solid var(--signal); outline-offset: 2px; }
  .portrait {
    display: block;
    border-radius: 6px;
    border: 1px solid var(--rule-strong);
    transition: transform 0.15s ease;
  }
  .zoom:hover .portrait { transform: scale(1.05); }
  .names {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
    text-decoration: none;
    color: var(--ink);
  }

  .lightbox {
    padding: 0;
    border: none;
    background: none;
    max-width: min(92vw, 1600px);
    max-height: 92vh;
    overflow: visible;
  }
  .lightbox::backdrop {
    background: rgb(29 18 16 / 0.85);
  }
  .lightbox[open] { animation: zoom-in 0.18s ease-out; }
  .lightbox img {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 92vh;
    border-radius: 6px;
    box-shadow: 0 1rem 3rem rgb(0 0 0 / 0.5);
  }
  .close {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    width: 2.25rem;
    height: 2.25rem;
    border: none;
    border-radius: 50%;
    background: rgb(29 18 16 / 0.55);
    color: #fff;
    font-size: 1.4rem;
    line-height: 1;
    cursor: pointer;
  }
  .close:hover { background: rgb(29 18 16 / 0.85); }
  @keyframes zoom-in {
    from { opacity: 0; transform: scale(0.96); }
    to { opacity: 1; transform: scale(1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .lightbox[open] { animation: none; }
    .portrait, .theme svg { transition: none; }
  }
  .name {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.02rem;
    letter-spacing: 0;
  }
  .role { font-size: 0.72rem; }

  .controls { display: flex; gap: 0.5rem; }

  .theme, .toggle {
    background: none;
    border: 1px solid var(--rule-strong);
    border-radius: 3px;
    padding: 0.55rem 0.6rem;
    cursor: pointer;
    color: var(--ink);
  }
  .theme { display: grid; place-items: center; padding: 0.45rem; }
  .theme:hover { border-color: var(--signal); color: var(--signal); }
  .theme svg { display: block; transition: transform 0.3s ease; }
  :global([data-theme='dark']) .theme svg { transform: rotate(180deg); }

  .bars, .bars::before, .bars::after {
    display: block;
    width: 16px;
    height: 1.5px;
    background: currentColor;
  }
  .bars { position: relative; }
  .bars::before, .bars::after { content: ''; position: absolute; left: 0; }
  .bars::before { top: -5px; }
  .bars::after { top: 5px; }

  .nav { display: none; padding-bottom: 1.25rem; }
  .nav.open { display: block; }

  ul { list-style: none; margin: 0; padding: 0; }
  li { margin: 0; }

  .nav a {
    display: block;
    padding: 0.45rem 0;
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 0.85rem;
    color: var(--slate);
    text-decoration: none;
    border-left: 2px solid transparent;
    padding-left: 0.85rem;
  }
  .nav a:hover { color: var(--ink); }
  .nav a[aria-current='page'] {
    color: var(--signal);
    border-left-color: var(--signal);
  }

  .locality {
    margin: 1.25rem 0 0;
    padding-left: 0.85rem;
    font-size: 0.72rem;
  }

  @media (min-width: 64rem) {
    .rail {
      position: sticky;
      top: 0;
      align-self: start;
      max-height: 100vh;
      overflow-y: auto;
      padding: clamp(2rem, 5vw, 4.5rem) 0 2rem;
      border-bottom: none;
      border-right: 1px solid var(--rule);
      margin-right: calc(var(--gap) * -0.5);
      padding-right: calc(var(--gap) * 0.5);
    }
    /* Unwrap the bar so the theme button can sit at the foot of the rail. */
    .rail { display: flex; flex-direction: column; }
    .bar, .controls { display: contents; }
    .identity { margin-bottom: 2rem; }
    .toggle { display: none; }
    .nav { display: block; padding-bottom: 0; }
    .theme { order: 1; align-self: flex-start; margin: 1.25rem 0 0 0.85rem; }
  }
</style>
