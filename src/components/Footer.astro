---
const year = new Date().getFullYear();
---
<footer>
  <p class="field">&copy; {year} Phillip Bruno</p>
  <ul>
    <li><a href="https://github.com/phillip-bruno" rel="me noopener" target="_blank">GitHub</a></li>
    <li><a href="https://www.linkedin.com/in/phillip-b-39b3884a/" rel="me noopener" target="_blank">LinkedIn</a></li>
    <li><a href="/assets/docs/phillip_bruno_resume.pdf" target="_blank">Resume</a></li>
  </ul>
</footer>

<style>
  footer {
    border-top: 1px solid var(--rule);
    padding: 1.5rem 0 2.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    align-items: baseline;
    justify-content: space-between;
    max-width: var(--measure);
  }
  p { margin: 0; }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 1.25rem;
  }
  a {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--slate);
    text-decoration: none;
  }
  a:hover { color: var(--signal); }
</style>
