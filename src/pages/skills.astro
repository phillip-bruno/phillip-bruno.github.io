---
import BaseLayout from '../layouts/BaseLayout.astro';

const sections = [
  {
    heading: 'Technical',
    groups: [
      { name: 'Data science & ML', items: ['Pandas', 'Polars', 'PyTorch', 'TensorFlow'] },
      { name: 'Cloud platforms', items: ['AWS', 'Azure', 'Google Cloud'] },
      { name: 'Analytics & visualization', items: ['Data Studio', 'Looker', 'Power BI', 'Tableau'] },
      { name: 'Languages', items: ['Python', 'T-SQL', 'Redshift SQL', 'Visual Basic'] },
    ],
  },
  {
    heading: 'Project management & operations',
    groups: [
      {
        name: 'Methodologies',
        items: ['Agile', 'Scrum', 'Kanban', 'SAFe', 'Six Sigma', 'PMBOK / Waterfall'],
      },
      {
        name: 'Tools',
        items: ['Asana', 'Jira', 'Confluence', 'Linear', 'Notion', 'Monday.com'],
      },
      {
        name: 'Management',
        items: [
          'Team and schedule management',
          'Risk management',
          'Stakeholder communication',
          'Sprint planning & retrospectives',
          'OKR / KPI tracking',
          'Budget & resource management',
          'Cross-functional collaboration',
        ],
      },
    ],
  },
];
---
<BaseLayout title="Skills" description="Technical and project management skills — Phillip Bruno, Lead Data Engineer.">
  <p class="eyebrow">Capabilities</p>
  <h1>Skills</h1>

  {sections.map(section => (
    <section class="block">
      <h2>{section.heading}</h2>
      <dl>
        {section.groups.map(group => (
          <div class="group">
            <dt class="field">{group.name}</dt>
            <dd>
              <ul>
                {group.items.map(item => <li>{item}</li>)}
              </ul>
            </dd>
          </div>
        ))}
      </dl>
    </section>
  ))}
</BaseLayout>

<style>
  .block { margin-bottom: 3.5rem; }
  h2 {
    font-size: var(--step-2);
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--rule-strong);
    margin-bottom: 0;
  }

  dl { margin: 0; }

  .group {
    display: grid;
    grid-template-columns: 13rem minmax(0, 1fr);
    gap: 0 1.5rem;
    padding: 1.15rem 0;
    border-bottom: 1px solid var(--rule);
  }

  dt { padding-top: 0.15rem; }
  dd { margin: 0; }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.15rem;
  }
  li { position: relative; }
  li + li::before {
    content: '';
    position: absolute;
    left: -0.6rem;
    top: 0.55em;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--rule-strong);
  }

  @media (max-width: 40rem) {
    .group { grid-template-columns: 1fr; gap: 0.5rem; }
  }
</style>
