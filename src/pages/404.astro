---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found" description="That page doesn't exist.">
  <p class="eyebrow">Error 404</p>
  <h1>Page not found</h1>
  <p class="note">
    This page was moved, deleted, or never existed in the first place.
  </p>
  <p class="redirect field">
    Returning home in <strong id="countdown">15</strong> seconds.
  </p>
  <p class="actions">
    <a href="/">Go home now</a> &middot; <a href="/blog">Read the blog</a>
  </p>
</BaseLayout>

<script>
  const countdownEl = document.getElementById('countdown');
  let timeLeft = 15;
  const timer = setInterval(() => {
    timeLeft -= 1;
    if (countdownEl) countdownEl.textContent = String(timeLeft);
    if (timeLeft <= 0) {
      clearInterval(timer);
      window.location.href = '/';
    }
  }, 1000);
</script>

<style>
  .note { color: var(--slate); max-width: 44ch; margin: 0 0 1.75rem; }
  .redirect { margin: 0 0 2rem; }
  .redirect strong { color: var(--signal); font-weight: 500; }
  .actions { font-family: var(--font-mono); font-size: var(--step--1); }
  .actions a { text-decoration: none; }
  .actions a:hover { text-decoration: underline; }
</style>
