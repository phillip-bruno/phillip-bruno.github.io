---
import BaseLayout from '../layouts/BaseLayout.astro';

const certificates = [
  { date: 'Jun 2024', title: 'AWS Certified Cloud Practitioner', issuer: 'Amazon', url: 'https://www.credly.com/badges/cd3dd32d-6f51-4495-96b6-a7414adb323a?source=linked_in_profile' },
  { date: 'Dec 2021', title: 'AWS Partner: Accreditation (Business)', issuer: 'Amazon', url: 'https://www.credly.com/badges/11f91ece-ac74-4519-a5b5-c97e4dec3b35?source=linked_in_profile' },
  { date: 'Aug 2021', title: 'AWS Certified Database — Specialty', issuer: 'LinkedIn', url: 'https://www.linkedin.com/in/phillip-b-39b3884a/details/certifications/' },
  { date: 'Sep 2019', title: 'Microsoft: Querying with Transact-SQL', issuer: 'edX', url: 'https://courses.edx.org/certificates/84baf226f34e44129ad7ba971dc7eba1' },
  { date: 'Mar 2019', title: 'Project Management Fundamentals', issuer: 'University of Waterloo', url: 'https://pd.uwaterloo.ca/OnlineCourse.aspx?courseCatalogID=dee366d9-1605-42b0-bee8-3a9cf6c826aa' },
];
---
<BaseLayout title="Education" description="Education and professional certifications — Phillip Bruno.">
  <p class="eyebrow">Credentials</p>
  <h1>Education</h1>

  <section class="block">
    <h2>Degree</h2>
    <div class="entry">
      <span class="date field">U of T</span>
      <div class="body">
        <h3>Honours Bachelor of Arts</h3>
        <p class="org field">
          <a href="https://www.artsci.utoronto.ca/" target="_blank" rel="noopener">Faculty of Arts &amp; Science</a>
        </p>
        <p class="note">Geographic Information Systems · Environment and Geography</p>
      </div>
    </div>
  </section>

  <section class="block">
    <h2>Certifications</h2>
    <ol class="entries">
      {certificates.map(cert => (
        <li class="entry">
          <span class="date field">{cert.date}</span>
          <div class="body">
            <h3>{cert.title}</h3>
            <p class="org field">
              <a href={cert.url} target="_blank" rel="noopener">{cert.issuer} &rarr;</a>
            </p>
          </div>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>

<style>
  .block { margin-bottom: 3.5rem; }
  h2 {
    font-size: var(--step-2);
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--rule-strong);
    margin-bottom: 0;
  }

  .entries { list-style: none; margin: 0; padding: 0; }

  .entry {
    display: grid;
    grid-template-columns: var(--ruler) minmax(0, 1fr);
    gap: 0 1.5rem;
    padding: 1.4rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .date { padding-top: 0.3rem; white-space: nowrap; }
  .body { min-width: 0; }

  h3 { font-size: var(--step-1); margin: 0 0 0.2rem; }
  .org { margin: 0; }
  .org a { text-decoration: none; }
  .org a:hover { text-decoration: underline; }
  .note { margin: 0.4rem 0 0; color: var(--slate); }

  @media (max-width: 40rem) {
    .entry { grid-template-columns: 1fr; gap: 0.35rem; }
    .date { padding-top: 0; }
  }
</style>
