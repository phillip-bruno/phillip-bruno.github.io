---
import BaseLayout from '../../layouts/BaseLayout.astro';

const postModules = import.meta.glob('./*.md', { eager: true });
const posts = Object.values(postModules) as any[];
const sorted = posts
  .filter(post => !post.frontmatter.pin)
  .sort(
    (a, b) =>
      new Date(b.frontmatter.date).valueOf() - new Date(a.frontmatter.date).valueOf()
  );
---
<BaseLayout title="Blog" description="Writing on data engineering, requirements, and the occasional shower thought — Phillip Bruno.">
  <p class="eyebrow">Writing</p>
  <h1>Blog</h1>
  <p class="intro">Shower thoughts, technical ramblings, and the occasional sassy observation.</p>

  <ol class="posts">
    {sorted.map(post => {
      const { title, date, tags = [], categories = [] } = post.frontmatter;
      const parsed = new Date(date);
      const formatted = parsed.toLocaleDateString('en-CA', {
        year: 'numeric', month: 'short', day: '2-digit',
      });
      return (
        <li class="post">
          <time class="date field" datetime={parsed.toISOString().slice(0, 10)}>{formatted}</time>
          <div class="body">
            <h2><a href={post.url}>{title}</a></h2>
            <p class="meta">
              {categories.length > 0 && <span class="cat field">{categories[0]}</span>}
              {tags.map((tag: string) => <span class="tag">{tag}</span>)}
            </p>
          </div>
        </li>
      );
    })}
  </ol>
</BaseLayout>

<style>
  .intro { color: var(--slate); margin: 0 0 3rem; max-width: 52ch; }

  .posts { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--rule-strong); }

  .post {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: 0 1.5rem;
    padding: 1.4rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .date { padding-top: 0.4rem; white-space: nowrap; }
  .body { min-width: 0; }

  h2 { font-size: var(--step-1); margin: 0 0 0.4rem; }
  h2 a { color: var(--ink); text-decoration: none; }
  h2 a:hover { color: var(--signal); }

  .meta { margin: 0; display: flex; flex-wrap: wrap; gap: 0.3rem 0.9rem; }
  .cat { color: var(--signal); }

  @media (max-width: 40rem) {
    .post { grid-template-columns: 1fr; gap: 0.35rem; }
    .date { padding-top: 0; }
  }
</style>
