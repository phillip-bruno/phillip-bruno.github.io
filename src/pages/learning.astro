  { date: '2020', cat: 'sci', title: 'Datorama Admin: Platform Fundamentals', issuer: 'Salesforce Datorama', files: [{ href: 'datorama-platform-fundamentals.png' }] },
  { date: 'Mar 2019', cat: 'pro', title: 'Project Management Fundamentals', issuer: 'University of Waterloo', note: '24 hours of professional development training.', files: [{ href: 'uwaterloo-project-management-fundamentals.pdf' }] },
  { date: 'Oct 2018', cat: 'sci', title: 'Google Analytics Individual Qualification', issuer: 'Google', files: [{ href: 'google-analytics-individual-qualification.pdf' }] },
