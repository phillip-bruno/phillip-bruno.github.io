  { date: 'Jun 2017', cat: 'sci', title: 'MicroStrategy 10.118: Advanced Reporting', issuer: 'MicroStrategy', files: [{ href: 'microstrategy-10-118-advanced-reporting.pdf' }] },
  { date: 'Jun 2017', cat: 'sci', title: 'Introduction to Model Building — Official Anaplanner', issuer: 'Anaplan', files: [{ href: 'anaplan-introduction-to-model-building.pdf' }] },
  { date: 'May 2017', cat: 'pro', title: 'Harvard ManageMentor: Stress Management', issuer: 'Harvard ManageMentor · Rogers', files: [{ href: 'harvard-managementor-stress-management.pdf' }] },
  { date: 'Mar 2017', cat: 'sci', title: 'DAT101x: Data Science Orientation', issuer: 'Microsoft · edX', files: [{ href: 'edx-dat101x-data-science-orientation.pdf' }] },
  { date: 'Mar 2017', cat: 'eng', title: 'DAT201x: Querying with Transact-SQL', issuer: 'Microsoft · edX', files: [{ href: 'edx-dat201x-querying-with-transact-sql.pdf' }] },
  { date: 'Nov 2015', cat: 'pro', title: 'Basic Presentation Skills: Delivering a Presentation', issuer: 'Rogers', files: [{ href: 'rogers-presentation-skills-delivering.pdf' }] },
  { date: 'Nov 2015', cat: 'pro', title: 'Basic Presentation Skills: Planning a Presentation', issuer: 'Rogers', files: [{ href: 'rogers-presentation-skills-planning.pdf' }] },
  { date: 'Aug 2015', cat: 'pro', title: 'Basic Business Math: Averages and Equations', issuer: 'Rogers', files: [{ href: 'rogers-basic-business-math.pdf' }] },
  { date: 'Jun 2015', cat: 'pro', title: 'Interpersonal Communication: Communicating with Confidence', issuer: 'Rogers', files: [{ href: 'rogers-communicating-with-confidence.pdf' }] },
];

// Colour order is validated (all pairs, both themes) — keep the order if you change hues.
const categories = [
  { key: 'eng', label: 'Data engineering & cloud' },
  { key: 'sci', label: 'Data science & analytics' },
  { key: 'pro', label: 'Professional skills' },
];
const catLabel = Object.fromEntries(categories.map(c => [c.key, c.label]));
const counts = Object.fromEntries(categories.map(c => [c.key, courses.filter(x => x.cat === c.key).length]));

const slug = (text: string) => text.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const yearOf = (date: string) => Number(date.slice(-4));
const monthOf = (date: string) => Math.max(0, months.indexOf(date.slice(0, 3)));

const entries = courses.map(course => ({ ...course, id: slug(course.title), year: yearOf(course.date) }));
const first = Math.min(...entries.map(e => e.year));
const last = Math.max(...entries.map(e => e.year));
const years = Array.from({ length: last - first + 1 }, (_, i) => first + i);
const catOrder = categories.map(c => c.key);
// Each year's stack: grouped by category from the baseline up, then by month.
const stacks = years.map(year => ({
  year,
  items: entries
    .filter(e => e.year === year)
    .sort((a, b) => catOrder.indexOf(a.cat) - catOrder.indexOf(b.cat) || monthOf(a.date) - monthOf(b.date)),
}));

// Career context under the axis. Boundaries are mid-year approximations.
const span = last + 1 - first;
const pos = (year: number) => `${((Math.max(year, first) - first) / span) * 100}%`;
const eras = [
  { label: 'Rogers', from: first, to: 2017.5 },
  { label: 'Omnicom', from: 2017.5, to: 2021.5 },
  { label: 'Exostatic', from: 2021.5, to: last + 1 },
];
---
<BaseLayout title="Learning" description="Courses and learning certificates completed by Phillip Bruno.">
  <p class="eyebrow">Courses &amp; certificates</p>
  <h1>Learning</h1>
  <p class="intro">{courses.length} courses and certificates since {first}, most recent first. Each links to the original certificate.</p>

  <div class="learning" id="learning">
    <div class="legend" role="group" aria-label="Filter by focus">
      {categories.map(c => (
        <button type="button" class="key" data-cat={c.key} aria-pressed="true">
          <span class="swatch" aria-hidden="true"></span>
          <span class="key-label">{c.label}</span>
          <span class="key-count field">{counts[c.key]}</span>
        </button>
      ))}
    </div>

    <figure class="chart">
      <figcaption class="sr-only">Certificates per year from {first} to {last}, coloured by focus. Each dot links to its entry in the list below.</figcaption>
      <div class="plot" style={`--years: ${years.length}`}>
        {stacks.map(stack => (
          <div class="col">
            <div class="stack">
              {stack.items.map(item => (
                <a
                  class="dot"
                  href={`#${item.id}`}
                  data-cat={item.cat}
                  data-title={item.title}
                  data-meta={`${item.date} · ${item.issuer}`}
                  aria-label={`${item.title}, ${item.date}, ${catLabel[item.cat]}`}
                ><span aria-hidden="true"></span></a>
              ))}
            </div>
            <span class="year field" aria-hidden="true"><span class="full">{stack.year}</span><span class="short">’{String(stack.year).slice(2)}</span></span>
          </div>
        ))}
        <div class="tip" role="tooltip" hidden><strong></strong><span class="field"></span></div>
      </div>
      <div class="eras" aria-hidden="true">
        {eras.map(era => (
          <span class="era field" style={`left: ${pos(era.from)}; width: calc(${pos(era.to)} - ${pos(era.from)})`}>{era.label}</span>
        ))}
      </div>
    </figure>

    <ol class="courses">
      {entries.map(course => (
        <li class="course" id={course.id} data-cat={course.cat}>
          <span class="date field">{course.date}</span>
          <div class="body">
            <h2>{course.title}</h2>
            <p class="org field">{course.issuer}</p>
            <p class="cat field"><span class="swatch" aria-hidden="true"></span>{catLabel[course.cat]}</p>
            {course.note && <p class="note">{course.note}</p>}
            <p class="files field">
              {course.files.length === 1
                ? <a href={`${dir}/${course.files[0].href}`} target="_blank" rel="noopener">View certificate &rarr;</a>
                : course.files.map(file => (
                    <a href={`${dir}/${file.href}`} target="_blank" rel="noopener">{file.label}</a>
                  ))}
            </p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</BaseLayout>

<script>
  const root = document.getElementById('learning');
  const plot = root?.querySelector<HTMLElement>('.plot');
  const tip = root?.querySelector<HTMLElement>('.tip');
  const dots = root ? [...root.querySelectorAll<HTMLAnchorElement>('.dot')] : [];

  const showTip = (dot: HTMLAnchorElement) => {
    if (!plot || !tip) return;
    tip.querySelector('strong')!.textContent = dot.dataset.title ?? '';
    tip.querySelector('span')!.textContent = dot.dataset.meta ?? '';
    tip.hidden = false;
    const box = plot.getBoundingClientRect();
    const d = dot.getBoundingClientRect();
    const x = d.left + d.width / 2 - box.left;
    // Keep the tooltip inside the plot horizontally.
    const half = tip.offsetWidth / 2;
    tip.style.left = `${Math.min(Math.max(x, half), box.width - half)}px`;
    tip.style.top = `${d.top - box.top}px`;
  };
  const hideTip = () => { if (tip) tip.hidden = true; };

  for (const dot of dots) {
    dot.addEventListener('pointerenter', () => showTip(dot));
    dot.addEventListener('focus', () => showTip(dot));
    dot.addEventListener('pointerleave', hideTip);
    dot.addEventListener('blur', hideTip);
  }

  // Legend buttons filter both the chart and the list; colours never change.
  for (const key of root?.querySelectorAll<HTMLButtonElement>('.key') ?? []) {
    key.addEventListener('click', () => {
      const on = key.getAttribute('aria-pressed') !== 'true';
      key.setAttribute('aria-pressed', String(on));
      const cat = key.dataset.cat!;
      root!.classList.toggle(`hide-${cat}`, !on);
      for (const dot of dots) if (dot.dataset.cat === cat) dot.tabIndex = on ? 0 : -1;
    });
  }
</script>

<style>
  .intro { color: var(--slate); margin: 0 0 2rem; }

  /* Validated with the dataviz palette checks against --paper in each theme (all pairs). */
  .learning {
    --cat-eng: light-dark(#11957c, #1aa598);
    --cat-sci: light-dark(#a25e2b, #c17f21);
    --cat-pro: light-dark(#9b1248, #d14a5f);
    --dot: 12px;
    --dot-gap: 4px;
  }
  [data-cat='eng'] { --cat: var(--cat-eng); }
  [data-cat='sci'] { --cat: var(--cat-sci); }
  [data-cat='pro'] { --cat: var(--cat-pro); }

  .swatch {
    display: inline-block;
    flex-shrink: 0;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--cat);
  }

  /* Legend / filter row */
  .legend { display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; margin: 0 0 1.5rem; }
  .key {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.3rem 0;
    border: none;
    background: none;
    color: var(--ink);
    font: inherit;
    font-size: var(--step--1);
    cursor: pointer;
  }
  .key-count { color: var(--slate); }
  .key[aria-pressed='false'] { color: var(--slate); }
  .key[aria-pressed='false'] .swatch { background: none; box-shadow: inset 0 0 0 1.5px var(--cat); }
  .key[aria-pressed='false'] .key-label { text-decoration: line-through; text-decoration-color: var(--rule-strong); }

  /* Chart */
  .chart { margin: 0 0 3rem; }
  .plot {
    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--years), minmax(0, 1fr));
    align-items: end;
    border-bottom: 1px solid var(--rule-strong);
  }
  .col { display: flex; flex-direction: column; align-items: center; }
  .stack { display: flex; flex-direction: column-reverse; align-items: center; padding-bottom: 6px; }

  /* The link is the hit target; it's wider and taller than the painted dot. */
  .dot {
    display: grid;
    place-items: center;
    width: 100%;
    min-width: 24px;
    height: calc(var(--dot) + var(--dot-gap));
    border-radius: 3px;
  }
  .dot span {
    width: var(--dot);
    height: var(--dot);
    border-radius: 50%;
    background: var(--cat);
    transition: transform 0.12s ease, opacity 0.15s ease;
  }
  .dot:hover span, .dot:focus-visible span { transform: scale(1.3); }
  .dot:focus-visible { outline-offset: 0; }

  .year {
    position: absolute;
    bottom: 0;
    transform: translateY(calc(100% + 0.4rem));
    font-size: 0.72rem;
  }
  .col { position: relative; }
  .year .short { display: none; }

  .eras { position: relative; height: 1.4rem; margin-top: 2.1rem; }
  .era {
    position: absolute;
    top: 0;
    padding: 0.35rem 0 0 0.4rem;
    border-left: 1px solid var(--rule-strong);
    border-top: 1px solid var(--rule);
    font-size: 0.68rem;
    white-space: nowrap;
    overflow: hidden;
  }

  .tip {
    position: absolute;
    z-index: 5;
    transform: translate(-50%, calc(-100% - 8px));
    max-width: min(18rem, 90%);
    padding: 0.5rem 0.7rem;
    background: var(--paper-raised);
    border: 1px solid var(--rule-strong);
    border-radius: 4px;
    box-shadow: 0 6px 18px rgb(0 0 0 / 0.12);
    pointer-events: none;
    line-height: 1.35;
  }
  .tip[hidden] { display: none; }
  .tip strong { display: block; font-family: var(--font-display); font-weight: 400; font-size: 0.9rem; }
  .tip span { display: block; margin-top: 0.2rem; font-size: 0.7rem; }

  /* Filtering */
  .learning.hide-eng .dot[data-cat='eng'],
  .learning.hide-sci .dot[data-cat='sci'],
  .learning.hide-pro .dot[data-cat='pro'] { pointer-events: none; }
  .learning.hide-eng .dot[data-cat='eng'] span,
  .learning.hide-sci .dot[data-cat='sci'] span,
  .learning.hide-pro .dot[data-cat='pro'] span { opacity: 0.15; }
  .learning.hide-eng .course[data-cat='eng'],
  .learning.hide-sci .course[data-cat='sci'],
  .learning.hide-pro .course[data-cat='pro'] { display: none; }

  /* List */
  .courses { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--rule-strong); }

  .course {
    display: grid;
    grid-template-columns: var(--ruler) minmax(0, 1fr);
    gap: 0 1.5rem;
    padding: 1.4rem 0;
    border-bottom: 1px solid var(--rule);
    scroll-margin-top: 1.5rem;
    transition: background-color 0.6s ease;
  }
  .course:target { background: color-mix(in srgb, var(--highlight) 14%, transparent); }
  .date { padding-top: 0.3rem; white-space: nowrap; }
  .body { min-width: 0; }

  h2 { font-size: var(--step-1); margin: 0 0 0.2rem; }
  .org { margin: 0; }
  .cat { display: flex; align-items: center; gap: 0.45rem; margin: 0.15rem 0 0; }
  .note { margin: 0.4rem 0 0; color: var(--slate); }

  .files { display: flex; flex-wrap: wrap; gap: 0.2rem 1.1rem; margin: 0.5rem 0 0; }
  .files a { text-decoration: none; }
  .files a:hover { text-decoration: underline; }

  @media (max-width: 40rem) {
    .course { grid-template-columns: 1fr; gap: 0.35rem; }
    .date { padding-top: 0; }
    .year .full { display: none; }
    .year .short { display: inline; }
  }
</style>
