---
import BaseLayout from '../layouts/BaseLayout.astro';

const employers = [
  {
    org: 'Exostatic Inc.',
    location: 'Toronto, ON',
    url: 'https://www.exostatic.com/',
    span: '2021 – Present',
    roles: [
      {
        title: 'Lead Data Engineer',
        span: '2021 – Present',
        summary:
          "I work closely with clients to help identify and scope out new project opportunities, then guide them through the initial stages of development. Within my team, I'm responsible for delegating tasks to keep our workflow running smoothly and ensuring everyone has the support they need to succeed. As a developer, I contribute to the coding process and also offer guidance and mentorship to my colleagues, helping us build high-quality solutions together.",
        points: [
          'Led data engineering team in creating scalable data systems, enhancing operational efficiency, reducing tech debt and decision-making.',
          'Utilized machine learning techniques to pioneer advanced data practices, improving the quality of data-driven insights.',
          'Worked with clients to product manage the sales pipeline, while launching multi-million dollar games.',
        ],
      },
    ],
  },
  {
    org: 'Omnicom Media Group',
    location: 'Toronto, ON',
    url: 'https://omnicommediagroup.com/',
    span: '2017 – 2021',
    roles: [
      {
        title: 'Senior Manager of Business Intelligence',
        span: '2019 – 2021',
        summary:
          'I streamlined business operations by automating ETL processes, boosting efficiency and accuracy. My work generated valuable industry insights for senior leadership, directly informing strategic decision-making. I was also deeply involved in meticulous requirements gathering and documentation, ensuring project clarity and success.',
        points: [
          'Earned a SPOT award for outstanding performance.',
          'Developed automated quality assurance tools for high-value clients, saving hundreds of hours and preventing errors in advance.',
        ],
      },
      {
        title: 'Intermediate Reporting Analyst',
        span: '2017 – 2019',
        summary:
          'I undertook a comprehensive review of internal reporting processes, identifying areas for improvement and implementing solutions to enhance their efficiency and streamline workflows for optimal performance. I developed a suite of customized reporting tools that accelerated report generation and significantly reduced manual labour hours annually.',
        points: [
          'Enhanced efficiency by automating reporting processes, saving close to 1,500 labour hours annually.',
          'Earned a bronze REAP award for assisting a client with an urgent deadline through automation.',
        ],
      },
    ],
  },
  {
    org: 'Rogers Sports and Media',
    location: 'Toronto, ON',
    url: 'https://www.rogerssportsandmedia.com/',
    span: '2012 – 2017',
    roles: [
      {
        title: 'Senior Business Systems Analyst',
        span: '2012 – 2017',
        summary:
          'Committed to maintaining the highest levels of data integrity, I developed innovative reporting and quality assurance tools. These tools were instrumental in minimizing errors, protecting financial resources, and ensuring the accuracy of crucial business data. I authored specialized applications and queries to automate quality assurance testing, streamlining the testing process and significantly reducing manual effort.',
        points: [
          'Awarded 2015 Employee of the Year at Rogers Sports and Media.',
          "Developed an engine for validating NHL advertisements for Rogers' advertising clients.",
          'Authored applications and queries to automate quality assurance testing, catching hundreds of thousands of dollars in advertising errors.',
        ],
      },
    ],
  },
];
---
<BaseLayout title="Career" description="Phillip Bruno's career history in data engineering and business intelligence.">
  <p class="eyebrow">Experience</p>
  <h1>Career</h1>
  <p class="intro">
    Fourteen years across broadcast, media, and product &mdash; most of it spent making
    reporting and data pipelines less painful for the people downstream.
  </p>
  <p class="resume">
    <a href="/assets/docs/phillip_bruno_resume.pdf" target="_blank">Download full resume (PDF)</a>
  </p>

  {employers.map(employer => (
    <section class="employer">
      <div class="employer-head">
        <span class="span field">{employer.span}</span>
        <div>
          <h2>
            <a href={employer.url} target="_blank" rel="noopener">{employer.org}</a>
          </h2>
          <p class="location field">{employer.location}</p>
        </div>
      </div>

      {employer.roles.map(role => (
        <article class="role">
          <span class="span field">{role.span}</span>
          <div class="role-body">
            <h3>{role.title}</h3>
            <p>{role.summary}</p>
            <ul>
              {role.points.map(point => <li>{point}</li>)}
            </ul>
          </div>
        </article>
      ))}
    </section>
  ))}
</BaseLayout>

<style>
  .intro { color: var(--slate); max-width: 56ch; margin: 0 0 1.25rem; }
  .resume { font-family: var(--font-mono); font-size: var(--step--1); margin: 0 0 3.5rem; }

  .employer { margin-bottom: 3.5rem; }

  .employer-head,
  .role {
    display: grid;
    grid-template-columns: var(--ruler) minmax(0, 1fr);
    gap: 0 1.5rem;
  }

  .employer-head {
    align-items: baseline;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--rule-strong);
  }
  .employer-head h2 { margin: 0; font-size: var(--step-2); }
  .employer-head h2 a { color: var(--ink); text-decoration: none; }
  .employer-head h2 a:hover { color: var(--signal); }
  .location { margin: 0.15rem 0 0; }

  .role { padding: 1.75rem 0; border-bottom: 1px solid var(--rule); }
  .role-body { min-width: 0; }
  .role h3 { margin: 0 0 0.5rem; font-size: var(--step-1); }
  .role p { margin: 0 0 0.85rem; }

  ul { margin: 0; padding-left: 1.1rem; color: var(--slate); }
  li { margin-bottom: 0.4rem; }
  li::marker { color: var(--rule-strong); }

  .span { white-space: nowrap; padding-top: 0.35rem; }

  @media (max-width: 40rem) {
    .employer-head, .role { grid-template-columns: 1fr; gap: 0.4rem; }
    .span { padding-top: 0; }
  }
</style>
