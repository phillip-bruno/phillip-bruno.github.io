---
import BaseLayout from '../layouts/BaseLayout.astro';

const awards = [
  { date: 'Dec 2020', org: 'Omnicom Media Group', title: 'Spot Award', note: 'Recognized for delivering performance that surpassed expectations.' },
  { date: 'Jul 2018', org: 'Omnicom Media Group', title: 'R.E.A.P. Award', note: 'Commended for innovatively automating a process previously considered manual only, resulting in significant cost savings.' },
  { date: 'Feb 2017', org: 'Rogers Sports and Media', title: 'MBU Sales Recognition — Platinum Club Winner', note: 'Acknowledged for streamlining departmental processes and implementing cost-saving measures.' },
  { date: 'Jan 2017', org: 'Rogers Sports and Media', title: 'MBU Sales Recognition — Sales Ops WOW', note: 'Awarded for exceptional performance and dedication in the sales operation department.' },
  { date: 'Jan 2016', org: 'Rogers Sports and Media', title: 'Employee of the Year', note: 'Honoured for demonstrating exceptional performance and commitment to corporate principles and values.' },
  { date: 'Jul 2015', org: 'Rogers Communications', title: 'Business Impact Award', note: 'Recognized for commitment to innovation and creating new benchmarks for success, driving growth and executing against strategic plans.' },
  { date: 'Jan 2014', org: 'Rogers Sports and Media', title: 'Team of the Year — Rogers Media', note: "Celebrated for commitment to innovation, creating new benchmarks for success, and driving growth in alignment with Rogers' Five-Year Plan." },
  { date: 'Jun 2013', org: 'Rogers Sports and Media', title: 'Business Impact Award', note: 'Acknowledged for commitment to innovation, setting new benchmarks for success, and driving growth.' },
];
---
<BaseLayout title="Awards" description="Recognition and awards received by Phillip Bruno.">
  <p class="eyebrow">Recognition</p>
  <h1>Awards</h1>
  <p class="intro">Eight awards across Rogers and Omnicom, listed most recent first.</p>

  <ol class="awards">
    {awards.map(award => (
      <li class="award">
        <span class="date field">{award.date}</span>
        <div class="body">
          <h2>{award.title}</h2>
          <p class="org field">{award.org}</p>
          <p class="note">{award.note}</p>
        </div>
      </li>
    ))}
  </ol>
</BaseLayout>

<style>
  .intro { color: var(--slate); margin: 0 0 3rem; }
  .awards { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--rule-strong); }

  .award {
    display: grid;
    grid-template-columns: var(--ruler) minmax(0, 1fr);
    gap: 0 1.5rem;
    padding: 1.4rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .date { padding-top: 0.3rem; white-space: nowrap; }
  .body { min-width: 0; }

  h2 { font-size: var(--step-1); margin: 0 0 0.2rem; }
  .org { margin: 0 0 0.5rem; }
  .note { margin: 0; color: var(--slate); }

  @media (max-width: 40rem) {
    .award { grid-template-columns: 1fr; gap: 0.35rem; }
    .date { padding-top: 0; }
  }
</style>
