---
import BaseLayout from '../layouts/BaseLayout.astro';

const stages = [
  {
    from: '2012',
    to: '2017',
    org: 'Rogers Sports and Media',
    roles: ['Senior Business Systems Analyst'],
  },
  {
    from: '2017',
    to: '2021',
    org: 'Omnicom Media Group',
    roles: ['Intermediate Reporting Analyst', 'Senior Manager, Business Intelligence'],
  },
  {
    from: '2021',
    to: 'now',
    org: 'Exostatic Inc.',
    roles: ['Lead Data Engineer'],
    current: true,
  },
];
---
<BaseLayout
  title="Home"
  description="Phillip Bruno — Lead Data Engineer in Toronto. Career history, writing, and the occasional sassy coffee critique."
>
  <p class="eyebrow">Lead Data Engineer &middot; Toronto</p>
  <h1>Phillip Bruno</h1>
  <p class="lede">A simple website with a bit about me, my work, and my occasional random thoughts.</p>
  <p class="blurb">
    My personal portfolio and blog chronicling the thrilling saga of my professional life &mdash;
    mostly a collection of shower thoughts and ramblings, sprinkled in with some sassy coffee critiques.
  </p>

  <ol class="pipeline" aria-label="Career history, earliest first">
    {stages.map(stage => (
      <li class:list={['stage', { current: stage.current }]}>
        <span class="span field">{stage.from}<span class="dash">&ndash;</span>{stage.to}</span>
        <span class="body">
          <span class="org">{stage.org}</span>
          <span class="roles field">{stage.roles.join(' → ')}</span>
        </span>
      </li>
    ))}
  </ol>

  <p class="more">
    <a href="/career">Full career detail</a> &middot; <a href="/blog">Read the blog</a>
  </p>
</BaseLayout>

<style>
  .lede {
    font-size: var(--step-1);
    line-height: 1.45;
    margin: 0 0 1rem;
    max-width: 34ch;
    text-wrap: balance;
  }
  .blurb {
    color: var(--slate);
    margin: 0 0 3.5rem;
    max-width: 58ch;
  }

  .pipeline {
    list-style: none;
    margin: 0 0 2.5rem;
    padding: 0;
    border-top: 1px solid var(--rule);
  }

  .stage {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: 0 1.5rem;
    align-items: baseline;
    padding: 1.15rem 0;
    border-bottom: 1px solid var(--rule);
    position: relative;
  }

  .span { white-space: nowrap; }
  .dash { opacity: 0.55; padding: 0 0.15em; }

  .body { display: flex; flex-direction: column; gap: 0.2rem; min-width: 0; }

  .org {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-1);
    letter-spacing: -0.02em;
  }
  .roles { color: var(--slate); }

  .stage.current .span,
  .stage.current .org { color: var(--signal); }
  .stage.current::before {
    content: '';
    position: absolute;
    left: -0.85rem;
    top: 1.55rem;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--signal);
  }

  .more { font-family: var(--font-mono); font-size: var(--step--1); }
  .more a { text-decoration: none; }
  .more a:hover { text-decoration: underline; }

  @media (max-width: 32rem) {
    .stage { grid-template-columns: 1fr; gap: 0.35rem; }
    .stage.current::before { display: none; }
  }
</style>
