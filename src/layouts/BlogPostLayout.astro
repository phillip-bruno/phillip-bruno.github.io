---
import BaseLayout from './BaseLayout.astro';

const { frontmatter } = Astro.props;
const { title, date, tags = [], categories = [] } = frontmatter;
const parsed = new Date(date);
const formatted = parsed.toLocaleDateString('en-CA', {
  year: 'numeric', month: 'long', day: 'numeric',
});
---
<BaseLayout title={title} description={`${title} — writing by Phillip Bruno.`}>
  <article>
    <header class="head">
      <p class="meta">
        <time class="field" datetime={parsed.toISOString().slice(0, 10)}>{formatted}</time>
        {categories.length > 0 && <span class="cat field">{categories.join(' / ')}</span>}
      </p>
      <h1>{title}</h1>
      {tags.length > 0 && (
        <p class="tags">
          {tags.map((tag: string) => <span class="tag">{tag}</span>)}
        </p>
      )}
    </header>

    <div class="prose">
      <slot />
    </div>

    <p class="back">
      <a href="/blog">&larr; All posts</a>
    </p>
  </article>
</BaseLayout>

<style>
  article { max-width: 66ch; }

  .head { padding-bottom: 1.75rem; border-bottom: 1px solid var(--rule); margin-bottom: 2.5rem; }
  .meta { display: flex; flex-wrap: wrap; gap: 0.3rem 1.25rem; margin: 0 0 0.85rem; }
  .cat { color: var(--signal); }
  h1 { margin: 0 0 0.85rem; }
  .tags { display: flex; flex-wrap: wrap; gap: 0.3rem 0.9rem; margin: 0; }

  .prose { font-size: 1.06rem; line-height: 1.72; }
  .prose :global(h2) { font-size: var(--step-2); margin: 2.75rem 0 0.75rem; }
  .prose :global(h3) { font-size: var(--step-1); margin: 2rem 0 0.6rem; }
  .prose :global(p) { margin: 0 0 1.25rem; }
  .prose :global(ul), .prose :global(ol) { margin: 0 0 1.25rem; padding-left: 1.3rem; }
  .prose :global(li) { margin-bottom: 0.45rem; }
  .prose :global(li)::marker { color: var(--rule-strong); }
  .prose :global(img) { margin: 2rem 0; border: 1px solid var(--rule); }
  .prose :global(hr) { margin: 3rem 0; }

  .back {
    margin: 4rem 0 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }
  .back a { text-decoration: none; }
  .back a:hover { text-decoration: underline; }
</style>
